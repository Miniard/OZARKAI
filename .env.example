# ===========================================
# OZARKAI - Variables d'environnement
# ===========================================
# Copiez ce fichier en .env et remplissez les valeurs

# ----------- BASE DE DONNÉES -----------
# PostgreSQL (Vercel Postgres, Supabase, Neon, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ----------- AUTHENTIFICATION -----------
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# En production: https://votre-domaine.com
NEXTAUTH_URL="http://localhost:3000"

# ----------- GOOGLE OAUTH -----------
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ----------- MICROSOFT OAUTH -----------
# Portal: https://portal.azure.com → Microsoft Entra ID → App registrations
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common"

# ----------- OPENAI API -----------
# Pour l'analyse automatique des factures
# Dashboard: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# ----------- OPTIONNEL: STOCKAGE S3 -----------
# Pour stocker les fichiers (si pas de base64)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="eu-west-3"
# AWS_S3_BUCKET=""

# ----------- OPTIONNEL: WHATSAPP -----------
# Meta Business: https://developers.facebook.com/
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""

